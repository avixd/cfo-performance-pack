{
  "name": "CFO Performance Pack",
  "dataColors": [
    "#3E5C8A",
    "#2A9DB0",
    "#E0A33A",
    "#8DB3D9",
    "#9AA5B4",
    "#5B6676",
    "#B8C2CF",
    "#2E7D32",
    "#C0392B"
  ],
  "foreground": "#1F2A37",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D32",
  "bad": "#C0392B",
  "neutral": "#9AA5B4",
  "textClasses": {
    "callout": {
      "fontSize": 19,
      "fontFace": "DIN",
      "color": "#1F2A37"
    },
    "title": {
      "fontSize": 10.5,
      "fontFace": "DIN",
      "color": "#1F2A37"
    },
    "header": {
      "fontSize": 10.5,
      "fontFace": "DIN",
      "color": "#1F2A37"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "DIN",
      "color": "#5B6676"
    },
    "smallLabel": {
      "fontSize": 8,
      "fontFace": "DIN",
      "color": "#5B6676"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontSize": 10.5
          }
        ],
        "padding": [
          {
            "top": 6,
            "bottom": 6,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#5B6676"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}