	measure 'Col Sidebar Active' = IF ( [Is Dark], "#1E3350", "#23497A" )
		displayFolder: 10 Theme
		lineageTag: 9346bcaa-4ac8-503a-a35e-3877c82700bb

	/// Theme colour "Title": #14213D light / #F1F5F9 dark.
	measure 'Col Title' = IF ( [Is Dark], "#F1F5F9", "#14213D" )
		displayFolder: 10 Theme
		lineageTag: ac09f315-f7ff-5472-a7b6-1ba1b423ec9c

	/// First name only (text before @, \ or .); never the full sign-in, domain or machine name. Anonymous (Publish to web) viewers see "guest".
	measure Greeting =
			VAR u = USERPRINCIPALNAME ()
			VAR a = IF ( CONTAINSSTRING ( u, "@" ), LEFT ( u, FIND ( "@", u ) - 1 ), IF ( CONTAINSSTRING ( u, "\" ), MID ( u, FIND ( "\", u ) + 1, 100 ), u ) )
			VAR f = IF ( CONTAINSSTRING ( a, "." ), LEFT ( a, FIND ( ".", a ) - 1 ), a )
			RETURN "Hello, " & IF ( LEN ( f ) = 0, "guest", UPPER ( LEFT ( f, 1 ) ) & LOWER ( MID ( f, 2, 40 ) ) )
		displayFolder: 10 Layout
		lineageTag: 41d295a9-da00-54d3-bec5-0c1b6f7f0c7f

	/// Report name shown at the top of the sidebar.
	measure Brand = "CFO Performance Pack"
		displayFolder: 10 Layout
		lineageTag: d5974801-2751-5ba9-812a-b67b7d68d073

	/// Fiscal year, period view and month currently in effect.
	measure 'Ctx Period' = [Selected Fiscal Year] & " " & SELECTEDVALUE ( 'Period View'[View], "YTD" ) & " " & FORMAT ( [Selected Month], "mmm yy" )
		displayFolder: 10 Layout
		lineageTag: 96dbbabc-218f-50e9-9ca1-819b3d1f1d50

	/// Reporting currency currently in effect.
	measure 'Ctx Currency' = [Currency Label] & IF ( [Currency Label] = "USD", " (translated via CAD)", "" )
		displayFolder: 10 Layout
		lineageTag: 73d45ba0-8ecd-5897-b816-fdb961caf08b

	/// Regions selected: "All regions", the names (up to two) or a count.
	measure 'Ctx Region' = VAR n = COUNTROWS ( VALUES ( Entity[Region] ) ) RETURN IF ( NOT ISFILTERED ( Entity[Region] ), "All regions", IF ( n <= 2, CONCATENATEX ( VALUES ( Entity[Region] ), Entity[Region], ", " ), n & " selected" ) )
		displayFolder: 10 Layout
		lineageTag: 2f553e1d-a003-5d3f-8dec-e02fc5d0ca0a

	/// Entities selected: all, the names (up to two) or a count.
	measure 'Ctx Entity' = VAR n = COUNTROWS ( VALUES ( Entity[EntityName] ) ) RETURN IF ( NOT ISFILTERED ( Entity[EntityName] ), "All entities", IF ( n <= 2, CONCATENATEX ( VALUES ( Entity[EntityName] ), Entity[EntityName], ", " ), n & " selected" ) )
		displayFolder: 10 Layout
		lineageTag: 450388ba-ddfe-5365-a36d-5806e729a27b

	/// Departments selected: all, the names (up to two) or a count.
	measure 'Ctx Department' = VAR n = COUNTROWS ( VALUES ( Department[DepartmentName] ) ) RETURN IF ( NOT ISFILTERED ( Department[DepartmentName] ), "All departments", IF ( n <= 2, CONCATENATEX ( VALUES ( Department[DepartmentName] ), Department[DepartmentName], ", " ), n & " selected" ) )
		displayFolder: 10 Layout
		lineageTag: 5b74bda3-fe94-5486-8caa-291190988e18

	/// Footer of the Overview page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer Overview' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Group % = effective ownership"
		displayFolder: 10 Layout
		lineageTag: a01a168f-9a93-53ef-a992-abd7693aa34d

	/// Footer of the Executive page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer Executive' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Var % shown only when actual and budget share a sign"
		displayFolder: 10 Layout
		lineageTag: 98014823-877a-5e0b-9e93-8a134086ac3e

	/// Footer of the Budget vs Actual page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer BvA' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Under-budgeted = actual > 2x budget"
		displayFolder: 10 Layout
		lineageTag: 3ee5b308-9ada-5982-a689-ff9b805b8d84

	/// Footer of the P&L page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer IS' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · CAD/USD thousands; costs negative, + = favourable"
		displayFolder: 10 Layout
		lineageTag: 747d299c-fe1e-5fc5-93c8-09a577a4fa4e

	/// Footer of the Balance Sheet page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer BS' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Equity roll-forward not reconciled in source data"
		displayFolder: 10 Layout
		lineageTag: 99083275-2f68-5714-99c8-1833cc79d1bc

	/// Footer of the Data Quality page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer DQ' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Counts recompute on every refresh"
		displayFolder: 10 Layout
		lineageTag: 4578e5f2-d396-5ab7-aed8-b3a772caa386

	/// The region that has reported longest: the like-for-like core against which newer regions are judged.
	measure 'Core Region' =
			VAR t = ADDCOLUMNS ( ALL ( Entity[Region] ), "@f", VAR r = Entity[Region] RETURN CALCULATE ( MIN ( GL[Month] ), REMOVEFILTERS (), GL[Scenario] = "Actual", Entity[Region] = r ) )
			RETURN MAXX ( TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@f] ) ), [@f], ASC, Entity[Region], ASC ), Entity[Region] )
		displayFolder: 3 KPIs\Perimeter
		lineageTag: cf9faa52-479b-561b-ab84-75fb4d3df675

	/// Revenue variance to budget for the core region only.
	measure 'Revenue Var Core' = VAR r = [Core Region] RETURN CALCULATE ( [Revenue Var vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 09e9d7e3-c479-516b-bafc-5d269e216c7a

	/// Revenue variance % to budget for the core region only.
	measure 'Revenue Var % Core' = VAR r = [Core Region] RETURN CALCULATE ( [Revenue Var % vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: b71eda3b-0aec-5a62-86d1-772bf0cbc27a

	/// EBITDA variance to budget for the core region only.
	measure 'EBITDA Var Core' = VAR r = [Core Region] RETURN CALCULATE ( [EBITDA Var vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: ce04c894-6c52-5372-82ec-209a90145f1f

	/// EBITDA variance % to budget for the core region only.
	measure 'EBITDA Var % Core' = VAR r = [Core Region] RETURN CALCULATE ( [EBITDA Var % vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 8bdc5647-b643-5d3f-98f0-22658128eebf

	/// Revenue variance from entities whose budget is credible (actual within 2x budget).
	measure 'Revenue Var Credible' =
			// Per-entity pattern: evaluated entity by entity and then summed, because the rule applies to each entity separately.
			SUMX ( VALUES ( Entity[EntityKey] ), IF ( NOT ISBLANK ( [Revenue Budget] ) && DIVIDE ( [Revenue], [Revenue Budget] ) <= 2, [Revenue Var vs Budget] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 8e50f408-2de5-533f-8cf5-2d4bd65c3219

	/// Rank of the absolute budget variance across every entity x P&L detail line in the current selection.
	measure 'Exception Rank' =
			IF ( HASONEVALUE ( Entity[EntityName] ) && HASONEVALUE ( 'Report Line'[LineKey] ) && SELECTEDVALUE ( 'Report Line'[LineType] ) = "Detail",
			    VAR cur = ABS ( [Line Var vs Budget] )
			    VAR grid = CROSSJOIN ( ALLSELECTED ( Entity[EntityName] ),
			        CALCULATETABLE ( VALUES ( 'Report Line'[LineKey] ), REMOVEFILTERS ( 'Report Line' ), 'Report Line'[LineType] = "Detail", 'Report Line'[Statement] = "Income Statement" ) )
			    RETURN IF ( NOT ISBLANK ( cur ), RANKX ( grid, CALCULATE ( ABS ( [Line Var vs Budget] ), REMOVEFILTERS ( 'Report Line'[LineName] ) ), cur, DESC, Dense ) ) )
		formatString: 0
		displayFolder: 7 Exceptions
		lineageTag: 29b7188a-1d83-5d8e-9782-c2b5527874bd

	/// Budget variance for rows ranked in the top 5 exceptions; blank otherwise, which keeps the table to five rows.
	measure 'Exception Var' = IF ( [Exception Rank] <= 5, [Line Var vs Budget] )
		formatString: #,0,;(#,0,);-
		displayFolder: 7 Exceptions
		lineageTag: abb91187-07ad-5689-8f9e-e7174b526d19

	/// Budget variance % for the top-5 exception rows.
	measure 'Exception Var %' = IF ( [Exception Rank] <= 5, [Line Var % vs Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 7 Exceptions
		lineageTag: e9a77f74-3e3f-57ee-ac6c-f5fa40e092f2

	/// Actual for the top-5 exception rows.
	measure 'Exception Actual' = IF ( [Exception Rank] <= 5, [Line Actual] )
		formatString: #,0,;(#,0,);-
		displayFolder: 7 Exceptions
		lineageTag: ff510c07-ba74-5291-b7c5-c384f33afdc2

	/// Rank 1 to 5 for the exception rows; blank for everything else.
	measure 'Exception Rank Shown' = IF ( [Exception Rank] <= 5, [Exception Rank] )
		formatString: 0
		displayFolder: 7 Exceptions
		lineageTag: 771f4717-56ab-5938-bf79-25e68007c397

	/// Text colour in the top-5 exception table: green favourable, red unfavourable.
	measure 'Exception Color' = IF ( [Exception Var] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 7252a2e5-9a21-5226-be88-60ae30b1fdbb

	/// Closing headcount at the selected month (statistical account 96).
	measure Headcount =
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR m = [Selected Month] RETURN CALCULATE ( SUM ( GL[AmountLC] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m, GL[Scenario] = "Actual", Account[AccountKey] = 96 )
		formatString: #,0
		displayFolder: 3 KPIs\People
		lineageTag: dd479a58-702a-5db7-b19c-6ad241a32431

	/// Closing headcount twelve months before the selected month.
	measure 'Headcount PY' =
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR m = EDATE ( [Selected Month], -12 ) RETURN CALCULATE ( SUM ( GL[AmountLC] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m, GL[Scenario] = "Actual", Account[AccountKey] = 96 )
		formatString: #,0
		displayFolder: 3 KPIs\People
		lineageTag: 8cbba16c-e7cf-5cea-a387-7d7e92bde8ac

	/// Salaries and benefits: actual minus budget (negative = over budget).
	measure 'Salaries Var vs Budget' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ) - CALCULATE ( [Budget (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: 3dc573d2-7f21-5dd4-9484-47d39bc5e63c

	/// Salaries & benefits for the period / closing headcount.
	measure 'Salary Cost per Head' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( -CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ), [Headcount] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: 4c9b1f62-650e-558e-b0e2-99ccd614e3cd

	/// Salary cost per head for the same period last year.
	measure 'Salary Cost per Head PY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( -CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ), [Headcount PY] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: e7168173-298e-5880-ad67-05f3d0e2de75

	/// Narrative: salaries versus budget, share of the opex overrun, headcount and cost per head versus last year.
	measure 'Insight People Cost' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			VAR sv = [Salaries Var vs Budget] VAR ov = [Operating Expenses Var vs Budget] VAR hc = [Headcount] VAR hp = [Headcount PY]
			VAR c = [Salary Cost per Head] VAR cp = [Salary Cost per Head PY]
			RETURN "Salaries & benefits ran " & ( VAR _x = ABS ( sv ) RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) ) & IF ( sv < 0, " over", " under" ) & " budget" & IF ( ov < 0 && sv < 0, ", " & FORMAT ( DIVIDE ( sv, ov ), "0%" ) & " of the opex overrun", "" ) & ". Headcount "
			    & FORMAT ( hc, "#,0" ) & " (" & FORMAT ( DIVIDE ( hc, hp ) - 1, "+0%;-0%" ) & " vs PY); salary cost per head " & FORMAT ( DIVIDE ( c, cp ) - 1, "+0.0%;-0.0%" ) & " vs PY."
		displayFolder: 6 Narrative
		lineageTag: 5eefb7ae-5e8a-56d1-b9cb-6b069b88dce5

	/// Outlook if the remaining months beat budget by the same ratio as the year to date.
	measure 'Metric Outlook Run-Rate' =
			// Template pattern: the report line (or metric) in context decides which accounts are summed, via TREATAS.
			VAR a = VAR lk = SELECTEDVALUE ( Metric[LineKey], 3 )
			VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = lk )
			RETURN CALCULATE ( [Actual YTD], TREATAS ( accts, Account[AccountKey] ) ) VAR b = VAR lk = SELECTEDVALUE ( Metric[LineKey], 3 )
			VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = lk )
			RETURN CALCULATE ( [Budget YTD], TREATAS ( accts, Account[AccountKey] ) )
			RETURN a + ( [Metric Budget FY] - b ) * DIVIDE ( a, b )
		formatString: #,0;(#,0);-
		displayFolder: 5 Metric Selector
		lineageTag: 5fef84bd-259b-5427-b435-a33deb66edaa

