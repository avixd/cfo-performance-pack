	/// Footer of the DD page: sources, exchange-rate policy, close month and page-specific caveats.
	measure 'Footer DD' = "Source: INFO.VIEW.TABLES, COLUMNS, MEASURES and RELATIONSHIPS, unioned in the calculated table Data Dictionary · refreshed with the model"
