		displayFolder: 11 KPI Cards
		lineageTag: a5b6796d-1dbd-5496-a0ac-a37cb2f48479

	/// KPI card value: [DIO (days)] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV DIO (days)' = FORMAT ( [DIO (days)], "#,0" )
		displayFolder: 11 KPI Cards
