	/// Change in Debt to Equity since the previous fiscal year end.
	measure 'Debt to Equity Change Text' = VAR d = [Debt to Equity] - [Debt to Equity (year end)] RETURN IF ( NOT ISBLANK ( [Debt to Equity (year end)] ), FORMAT ( d, "▲ 0.00;▼ 0.00;0.00" ) & "x vs " & [Year-End Label] )
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
