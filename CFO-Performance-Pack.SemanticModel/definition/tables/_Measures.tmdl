	measure 'Sub Cash Trend' =
			VAR ms = FILTER ( ALL ( 'Date'[Month] ), 'Date'[Month] <= [As Of Month] )
			VAR t = ADDCOLUMNS ( ms, "@c", VAR m = 'Date'[Month] RETURN CALCULATE ( [Cash Balance (month)], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m ) )
			VAR hi = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@c] ) ), [@c], DESC ) VAR lo = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@c] ) ), [@c], ASC )
			RETURN "Month-end cash ranged " & FORMAT ( ( MAXX ( lo, [@c] ) ) / 1e6, "#,0.0" ) & "M" & " (" & FORMAT ( MAXX ( lo, 'Date'[Month] ), "mmm yy" ) & ") to " & FORMAT ( ( MAXX ( hi, [@c] ) ) / 1e6, "#,0.0" ) & "M" & " (" & FORMAT ( MAXX ( hi, 'Date'[Month] ), "mmm yy" ) & "); it moves with working capital, not profit." 
		displayFolder: 6 Narrative\Subtitles
		lineageTag: a87ab307-2f34-57e2-be4d-52b7398eb2cb

