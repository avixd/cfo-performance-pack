	/// Divisor chosen with the Thousand / Absolute toggle (thousand by default).
	measure 'Unit Divisor' = SELECTEDVALUE ( 'Display Unit'[Divisor], 1000 )
		formatString: 0
		displayFolder: 13 Statement Explorer
		lineageTag: f9eaa55b-b8bb-5810-b3a9-0346ff5d2e05

	/// Current period for the section or line on the row. A section header shows the union of its lines' accounts, i.e. the section total.
	measure 'IS CY Raw' =
			// Template pattern: the report line (or metric) in context decides which accounts are summed, via TREATAS.
			IF ( HASONEVALUE ( 'Report Line'[Section] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Actual (Period)], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 13 Statement Explorer
		lineageTag: 7545b6fa-95eb-541b-878c-944e5df625b4

	/// Same period last year for the section or line on the row.
	measure 'IS PY Raw' =
			// Template pattern: the report line (or metric) in context decides which accounts are summed, via TREATAS.
			IF ( HASONEVALUE ( 'Report Line'[Section] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Prior Year (Period)], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 13 Statement Explorer
		lineageTag: 8582c869-2866-559d-ad51-1af33852e9c7

	/// Current period, in the unit chosen with the toggle.
	measure 'IS CY' = DIVIDE ( [IS CY Raw], [Unit Divisor] )
		formatString: #,0;(#,0);-
		displayFolder: 13 Statement Explorer
		lineageTag: 769921c0-6a55-5e0c-a5fc-d4de84a4952f

	/// Prior year, in the unit chosen with the toggle.
	measure 'IS PY' = DIVIDE ( [IS PY Raw], [Unit Divisor] )
		formatString: #,0;(#,0);-
		displayFolder: 13 Statement Explorer
		lineageTag: bef1e4f4-70ef-5532-9a91-64e7a60a8920

	/// Current period as a share of net revenue (common size).
	measure 'IS CY % Rev' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( [IS CY Raw], CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) ) )
		formatString: 0.00%
		displayFolder: 13 Statement Explorer
		lineageTag: ef165994-ecb9-5ccb-84a6-8392a552449b

	/// Prior year as a share of prior-year net revenue.
	measure 'IS PY % Rev' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( [IS PY Raw], CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) ) )
		formatString: 0.00%
		displayFolder: 13 Statement Explorer
		lineageTag: 4bf3c87c-9288-56b0-8a00-5b990198dc59

	/// Change versus prior year, in the chosen unit. Positive = favourable, because costs are stored negative.
	measure 'IS Chg PY' = DIVIDE ( [IS CY Raw] - [IS PY Raw], [Unit Divisor] )
		formatString: #,0;(#,0);-
		displayFolder: 13 Statement Explorer
		lineageTag: 473050a1-1dbf-5d8b-aac6-53bcf379fbf4

	/// Change versus prior year in %. Blank when the signs differ or the change exceeds 1,000%.
	measure 'IS Chg % PY' = VAR p = IF ( [IS CY Raw] * [IS PY Raw] > 0, DIVIDE ( [IS CY Raw] - [IS PY Raw], ABS ( [IS PY Raw] ) ) ) RETURN IF ( ABS ( p ) < 10, p )
		formatString: 0.0%;-0.0%;-
		displayFolder: 13 Statement Explorer
		lineageTag: bec556db-a04d-5b20-9b7d-5ab5acc4321b

	/// Change in the share of revenue, in basis points (100 bps = 1 percentage point).
	measure 'IS Chg Rev bps' = ( [IS CY % Rev] - [IS PY % Rev] ) * 10000
		formatString: #,0.0
		displayFolder: 13 Statement Explorer
		lineageTag: d3c7776e-eb56-5976-ae78-ee70639de7d6

	/// Green when the row is favourable to prior year (higher revenue or profit, lower cost).
	measure 'IS Chg Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [IS CY Raw] ) && NOT ISBLANK ( [IS PY Raw] ), [IS CY Raw] >= [IS PY Raw] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: 838540aa-4eb5-5010-9fb1-edacf9940a5a

	/// Matrix shading: section headers tinted, detail lines on the panel colour.
	measure 'IS Row Background' = IF ( ISINSCOPE ( 'Report Line'[LineName] ), [Col Panel], [Col Subtotal] )
		displayFolder: 8 Formatting
		lineageTag: ca8a11cb-4738-5808-ba7c-cef23b6cef3d

	/// Date range covered by the current Period view, e.g. 01-Apr-26 to 31-Oct-26.
	measure 'IS Range' =
			VAR m = [Selected Month]
			VAR winStart = SWITCH ( SELECTEDVALUE ( 'Period View'[View], "YTD" ), "MTD", m, "QTD", DATE ( YEAR ( m ), INT ( ( MONTH ( m ) - 1 ) / 3 ) * 3 + 1, 1 ), DATE ( ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) - 1, 4, 1 ) )
			RETURN FORMAT ( winStart, "dd-mmm-yy" ) & " to " & FORMAT ( EOMONTH ( m, 0 ), "dd-mmm-yy" )
		displayFolder: 13 Statement Explorer
		lineageTag: 4e8a5d79-a904-5d61-addb-a59ccc30be41

	/// Card row: Revenue for the same period last year.
	measure 'IS Revenue PY Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"PY   " & ( VAR _x = [Revenue PY] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 13 Statement Explorer
		lineageTag: 01c23716-362d-5bd0-a04c-a1ec18023c8e

	/// Card row: Revenue change versus last year, as an amount.
	measure 'IS Revenue Chg Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"Change ($)   " & ( VAR _x = [Revenue] - [Revenue PY] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "+$#,0.0\M;-$#,0.0\M;$0.0\M" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "+$#,0\K;-$#,0\K;$0\K" ), FORMAT ( _x, "+$#,0;-$#,0;$0" ) ) ) )
		displayFolder: 13 Statement Explorer
		lineageTag: 48dce792-b16a-5435-8a04-9c4eed23d862

	/// Card row: Revenue change versus last year, in %.
	measure 'IS Revenue Pct Text' = "% Change   " & FORMAT ( DIVIDE ( [Revenue] - [Revenue PY], ABS ( [Revenue PY] ) ), "▲ 0.0%;▼ 0.0%;0.0%" )
		displayFolder: 13 Statement Explorer
		lineageTag: 03214dbe-0000-5873-b6f4-58416018be04

	/// Green when Revenue is favourable to last year.
	measure 'IS Revenue PY Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [Revenue PY] ), [Revenue] >= [Revenue PY] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: 6ce300ad-fd70-5d1d-b80f-a78d076cc39b

	/// KPI card value: [Cost of Sales] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Cost of Sales' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			( VAR _x = [Cost of Sales] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 11 KPI Cards
		lineageTag: a4a88882-dc88-528c-8ca8-84d61361fcd6

	/// Card row: COGS for the same period last year.
	measure 'IS Cost of Sales PY Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"PY   " & ( VAR _x = [Cost of Sales PY] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 13 Statement Explorer
		lineageTag: 35cc76b7-e7a0-5726-a07d-bf90cddf1473

	/// Card row: COGS change versus last year, as an amount.
	measure 'IS Cost of Sales Chg Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"Change ($)   " & ( VAR _x = [Cost of Sales] - [Cost of Sales PY] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "+$#,0.0\M;-$#,0.0\M;$0.0\M" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "+$#,0\K;-$#,0\K;$0\K" ), FORMAT ( _x, "+$#,0;-$#,0;$0" ) ) ) )
		displayFolder: 13 Statement Explorer
		lineageTag: 727de02d-2d7d-5dde-8b71-e09139fc89d0

	/// Card row: COGS change versus last year, in %.
	measure 'IS Cost of Sales Pct Text' = "% Change   " & FORMAT ( DIVIDE ( [Cost of Sales] - [Cost of Sales PY], ABS ( [Cost of Sales PY] ) ), "▲ 0.0%;▼ 0.0%;0.0%" )
		displayFolder: 13 Statement Explorer
		lineageTag: f9cd93d3-08b1-58ed-8c2e-52cc972b5621

	/// Green when COGS is favourable to last year.
	measure 'IS Cost of Sales PY Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [Cost of Sales PY] ), [Cost of Sales] >= [Cost of Sales PY] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: c5f8cb64-3c84-58dc-b8f3-aa0574eb6400

	/// KPI card value: [Gross Profit] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Gross Profit' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			( VAR _x = [Gross Profit] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 11 KPI Cards
		lineageTag: 93a7bbef-8c58-5062-a2a4-07afaf0bf5a8

	/// Card row: Gross Profit for the same period last year.
	measure 'IS Gross Profit PY Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"PY   " & ( VAR _x = [Gross Profit PY] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 13 Statement Explorer
