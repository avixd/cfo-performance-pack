	/// Change in DIO (days) since the previous fiscal year end.
	measure 'DIO Change Text' = VAR d = [DIO (days)] - [DIO (year end)] RETURN IF ( NOT ISBLANK ( [DIO (year end)] ), FORMAT ( d, "▲ #,0;▼ #,0;#,0" ) & " days vs " & [Year-End Label] )
