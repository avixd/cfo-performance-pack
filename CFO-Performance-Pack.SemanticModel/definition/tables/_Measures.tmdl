	measure 'VT BS' = "Balance sheet at " & FORMAT ( [Selected Month], "mmm yyyy" ) & " vs " & FORMAT ( DATE ( ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) - 1, 3, 1 ), "mmm yyyy" ) & " · " & [Currency Label] & " thousands"
		displayFolder: 6 Narrative\Visual titles
