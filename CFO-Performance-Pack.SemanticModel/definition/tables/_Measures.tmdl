	measure 'Ctx Entity' = VAR n = COUNTROWS ( VALUES ( Entity[EntityName] ) ) RETURN IF ( NOT ISFILTERED ( Entity[EntityName] ), "All entities", IF ( n <= 2, CONCATENATEX ( VALUES ( Entity[EntityName] ), Entity[EntityName], ", " ), n & " selected" ) )
		displayFolder: 10 Layout
		lineageTag: 450388ba-ddfe-5365-a36d-5806e729a27b

	measure 'Ctx Department' = VAR n = COUNTROWS ( VALUES ( Department[DepartmentName] ) ) RETURN IF ( NOT ISFILTERED ( Department[DepartmentName] ), "All departments", IF ( n <= 2, CONCATENATEX ( VALUES ( Department[DepartmentName] ), Department[DepartmentName], ", " ), n & " selected" ) )
