	/// Green when the selected metric is at or above the same period last year.
	measure 'Metric Growth Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [Metric Growth %] ), [Metric Actual] >= [Metric PY] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: 5eadc1a3-b200-5e21-85b4-5d2282d20d61

	/// Green when revenue grew versus the same period last year.
	measure 'Revenue Growth Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [Revenue Growth %] ), [Revenue Growth %] >= 0 ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: fcb3ff20-7ade-5e07-a9a8-489b98a0a26a

	/// EBITDA margin versus budget margin, in percentage points.
	measure 'EBITDA Margin Text' = FORMAT ( [EBITDA Margin pts vs Budget] * 100, "▲ 0.0;▼ 0.0;0.0" ) & " pts vs budget"
		displayFolder: 3 KPIs\Margins
		lineageTag: d160d12d-0ff6-52fd-b854-a46a1b16257c

	/// Green when EBITDA margin is at or above the budget margin.
	measure 'EBITDA Margin Var Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [EBITDA Margin pts vs Budget] ), [EBITDA Margin pts vs Budget] >= 0 ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: fd4aaa09-03f1-521f-b33b-819dea2fbe6b

	/// Budgeted operating expenses as a share of budgeted revenue.
	measure 'OpEx % of Revenue Budget' = DIVIDE ( -[Operating Expenses Budget], [Revenue Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: c1d1e839-c028-554f-b265-cb86762f0474

	/// Operating-expense ratio versus the budget ratio, in percentage points (a rise is unfavourable).
	measure 'OpEx Ratio Text' = FORMAT ( ( [OpEx % of Revenue] - [OpEx % of Revenue Budget] ) * 100, "▲ 0.0;▼ 0.0;0.0" ) & " pts vs budget"
		displayFolder: 3 KPIs\Margins
		lineageTag: 4539c87d-f566-5278-b723-8c470a8efd79

	/// Green when operating expenses take a smaller share of revenue than budgeted.
	measure 'OpEx Ratio Var Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [OpEx % of Revenue Budget] ), [OpEx % of Revenue] <= [OpEx % of Revenue Budget] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: b5b67f8f-30c2-55fc-930b-489539bd94a5

	/// Change in salary cost per head versus last year, with closing headcount.
	measure 'Salary per Head Text' = VAR g = DIVIDE ( [Salary Cost per Head], [Salary Cost per Head PY] ) - 1 RETURN IF ( NOT ISBLANK ( [Salary Cost per Head PY] ), FORMAT ( g, "▲ 0.0%;▼ 0.0%;0.0%" ) & " vs PY · headcount " & FORMAT ( [Headcount], "#,0" ) )
		displayFolder: 3 KPIs\People
		lineageTag: e7550785-c0d0-5611-a5b6-5d44c6b2d513

	/// Green when salary cost per head is at or below last year.
	measure 'Salary per Head Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [Salary Cost per Head PY] ), [Salary Cost per Head] <= [Salary Cost per Head PY] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
		displayFolder: 8 Formatting
		lineageTag: f00f5321-472a-5a43-88dd-22636d291770

	/// Month of the previous fiscal year end (March), used as the balance-sheet comparative.
	measure 'Year-End Label' = FORMAT ( DATE ( ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) - 1, 3, 1 ), "mmm yyyy" )
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: f468f5c4-8a94-51f8-b184-78ed78a80d3f

	/// Revenue for the twelve months ending at the previous fiscal year end; denominator for the year-end working-capital days.
	measure 'Revenue TTM (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR ye = DATE ( ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) - 1, 3, 1 )
			RETURN CALCULATE ( CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] > EDATE ( ye, -12 ) && 'Date'[Month] <= ye )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: ff249abd-b74a-5ccd-9592-68df5849a1f5

	/// Cost of Sales for the twelve months ending at the previous fiscal year end; denominator for the year-end working-capital days.
	measure 'Cost of Sales TTM (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR ye = DATE ( ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) - 1, 3, 1 )
			RETURN CALCULATE ( CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 4 ), Account[AccountKey] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] > EDATE ( ye, -12 ) && 'Date'[Month] <= ye )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 933c4b7c-ab35-5b70-953d-d170d8eacfa1

	/// Receivable days at the previous fiscal year end.
	measure 'DSO (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 102 ), Account[AccountKey] ) ), [Revenue TTM (year end)] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 9d6a8890-b1c1-58e2-982d-1ea4af0ea43d

	/// Inventory days at the previous fiscal year end.
	measure 'DIO (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 103 ), Account[AccountKey] ) ), -[Cost of Sales TTM (year end)] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 4ab42d79-6751-50cd-ac58-d8b954293f52

	/// Payable days at the previous fiscal year end.
	measure 'DPO (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 109 ), Account[AccountKey] ) ), -[Cost of Sales TTM (year end)] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: eecc9195-dc95-57bc-846c-2ec3f79b53e7

	/// Cash conversion cycle at the previous fiscal year end.
	measure 'Cash Conversion Cycle (year end)' = [DSO (year end)] + [DIO (year end)] - [DPO (year end)]
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 79278bd8-83a6-598b-961b-9f96e60813ae

	/// Current assets / current liabilities at the previous fiscal year end.
	measure 'Current Ratio (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 105 ), Account[AccountKey] ) ), CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 113 ), Account[AccountKey] ) ) )
		formatString: 0.00
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 84d0886c-f278-589e-97b3-f1fa62be02e6

	/// Short- and long-term debt / total equity at the previous fiscal year end.
	measure 'Debt to Equity (year end)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			DIVIDE ( CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 111 ), Account[AccountKey] ) ) + CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 114 ), Account[AccountKey] ) ), CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 119 ), Account[AccountKey] ) ) )
		formatString: 0.00
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 62ad9804-a60f-556c-90f0-14cbd5e8747f

	/// Change in DSO (days) since the previous fiscal year end.
	measure 'DSO Change Text' = VAR d = [DSO (days)] - [DSO (year end)] RETURN IF ( NOT ISBLANK ( [DSO (year end)] ), FORMAT ( d, "▲ #,0;▼ #,0;#,0" ) & " days vs " & [Year-End Label] )
		displayFolder: 4 Balance Sheet KPIs\Year-end comparatives
		lineageTag: 65dbd9b9-104c-50c2-8811-0c207eb42536

	/// Green when DSO (days) moved in the favourable direction since the year end.
	measure 'DSO Change Color' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			VAR g = IF ( NOT ISBLANK ( [DSO (year end)] ), [DSO (days)] <= [DSO (year end)] ) RETURN IF ( ISBLANK ( g ), [Col Muted], IF ( g, [Col Good], [Col Bad] ) )
