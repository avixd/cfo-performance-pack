	measure Cash = CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 101 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: f3fbe669-e16c-5f4d-8e15-07d623929f35

	measure 'Total Assets' = CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 108 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: f486df1f-05d7-585a-9b32-fe2691d0141b

	measure 'Total Equity' = CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 119 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 62e86610-0272-5bce-827a-3006673a8a5a

	measure 'Current Ratio' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 105 ), Account[AccountKey] ) ), CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 113 ), Account[AccountKey] ) ) )
		formatString: 0.00
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: f5dc2ba2-3d62-55ea-806f-b0b7e8a28e6a

	measure 'Debt to Equity' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 111 ), Account[AccountKey] ) ) + CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 114 ), Account[AccountKey] ) ), CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 119 ), Account[AccountKey] ) ) )
		formatString: 0.00
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 0fef3ee4-566b-584a-954a-1812b16ed00d

	measure 'Cost of Sales TTM' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 4 ), Account[AccountKey] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] > EDATE ( m, -12 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 243ff9fb-50c6-53ea-aafb-5de54f55d563

	/// Receivables / trailing-twelve-month revenue x 365.
	measure 'DSO (days)' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 102 ), Account[AccountKey] ) ), [Revenue TTM] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 9ec9739c-fdb4-5153-a735-54c34a596305

	/// Payables / TTM cost of sales x 365.
	measure 'DPO (days)' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 109 ), Account[AccountKey] ) ), -[Cost of Sales TTM] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 4a877de0-5353-51fe-841f-1e8c950bd98c

	/// Inventory / TTM cost of sales x 365.
	measure 'DIO (days)' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 103 ), Account[AccountKey] ) ), -[Cost of Sales TTM] ) * 365
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 51d5c246-fb7d-5a22-bb03-3ad8d66cf234

	measure 'Cash Conversion Cycle (days)' = [DSO (days)] + [DIO (days)] - [DPO (days)]
		formatString: 0
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: bc16a9d4-2705-5d1b-84a6-d7f5e5b6fc0f

	measure 'Title Overview' = "Adventure Works Group · FY" & ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) & " month " & [Fiscal Month Of Selection] & " of 12 (closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & ") · " & [Currency Label]
		displayFolder: 6 Narrative
		lineageTag: cde3fd62-2a52-538c-a267-628b28ad3f20

	measure 'Title Executive' = "Executive summary · " & [Selected Fiscal Year] & " " & [Period Label]
		displayFolder: 6 Narrative
		lineageTag: ac17b55f-ba34-5a95-80f2-cf7e3060dd51

	/// One-sentence executive headline that updates with every filter.
	measure Headline =
			VAR rv = [Revenue Var % vs Budget] VAR og = [Organic Growth %] VAR ev = [EBITDA Var % vs Budget]
			RETURN [Currency Label] & " " & FORMAT ( [Revenue] / 1e6, "#,0.0" ) & "M" & " revenue, " & FORMAT ( ABS ( rv ), "0.0%" ) & IF ( rv >= 0, " above", " below" ) & " budget ("
			    & FORMAT ( og, "+0.0%;-0.0%" ) & " organic growth). EBITDA " & FORMAT ( [EBITDA] / 1e6, "#,0.0" ) & "M" & ", " & FORMAT ( ev, "+0.0%;-0.0%" ) & " vs budget."
		displayFolder: 6 Narrative
		lineageTag: f25fa65d-ea2e-538e-810f-79f356ba544a

	measure 'Insight Perimeter' =
			VAR nu = [Revenue New Entities] VAR ub = [Revenue Unbudgeted]
			RETURN IF ( nu > 0 || ub > 0,
			    "Entities new to the group added " & [Currency Label] & " " & FORMAT ( nu / 1e6, "#,0.0" ) & "M" & "; " & [Currency Label] & " " & FORMAT ( ub / 1e6, "#,0.0" ) & "M" & " of revenue has no budget behind it. Excluding unbudgeted entities, revenue is "
			        & FORMAT ( [Revenue Var % vs Budget (Budgeted Entities)], "+0.0%;-0.0%" ) & " vs budget.",
			    "No change in the group perimeter versus last year." )
		displayFolder: 6 Narrative
		lineageTag: 1d0c2e8d-f8fa-5fa8-af9e-617136b3ac5a

	measure 'Insight Cost Absorption' =
			VAR gp = [Gross Profit Var vs Budget] VAR ox = [Operating Expenses Var vs Budget]
			RETURN IF ( gp > 0 && ox < 0,
			    "Operating expenses ran " & [Currency Label] & " " & FORMAT ( -ox / 1e6, "#,0.0" ) & "M" & " over budget, absorbing " & FORMAT ( DIVIDE ( -ox, gp ), "0%" ) & " of the gross-profit upside.",
			    IF ( ox >= 0, "Operating expenses are within budget.", "Gross profit is below budget and operating expenses are over budget." ) )
		displayFolder: 6 Narrative
		lineageTag: 86f1de69-9258-5da9-b268-11277e5ae958

	measure 'Insight Outlook' =
			VAR g = [Net Income Outlook FY] - [Net Income Budget FY]
			RETURN "Full-year outlook: net income " & [Currency Label] & " " & FORMAT ( [Net Income Outlook FY] / 1e6, "#,0.0" ) & "M" & " vs budget " & FORMAT ( [Net Income Budget FY] / 1e6, "#,0.0" ) & "M"
			    & " (" & FORMAT ( g / 1e6, "+#,0.0;-#,0.0" ) & "M), assuming the remaining months land on budget."
		displayFolder: 6 Narrative
		lineageTag: c03ec82c-69bf-5300-9391-cb020134b121

	measure 'Title BvA' = [Metric Name] & " · " & [Period Label] & ": " & [Currency Label] & " " & FORMAT ( [Metric Actual] / 1e6, "#,0.0" ) & "M" & ", " & FORMAT ( ABS ( [Metric Var % vs Budget] ), "0.0%" ) & IF ( [Metric Var vs Budget] >= 0, " favourable", " unfavourable" ) & " to budget"
		displayFolder: 6 Narrative
		lineageTag: 0d12a3fb-1ec7-5261-875b-3eed66af936c

	measure 'Title BvA Trend' = [Metric Name] & " by month, " & [Selected Fiscal Year] & ": actual to " & FORMAT ( [As Of Month], "mmm yyyy" ) & ", budget as outlook thereafter"
		displayFolder: 6 Narrative
		lineageTag: d7ad63fe-c0fb-5cce-8a7d-25b45956ee7b

	measure 'Title BvA Outlook' = "Full-year outlook " & [Currency Label] & " " & FORMAT ( [Metric Outlook FY] / 1e6, "#,0.0" ) & "M" & " vs budget " & FORMAT ( [Metric Budget FY] / 1e6, "#,0.0" ) & "M" & " (" & FORMAT ( [Metric Outlook Gap] / 1e6, "+#,0.0;-#,0.0" ) & "M)"
		displayFolder: 6 Narrative
		lineageTag: a10d1423-e11e-5f07-a7cf-40b9c889eeb8

	measure 'Title Variance by Entity' = "Where the " & LOWER ( [Metric Name] ) & " variance comes from: by entity (green = favourable)"
		displayFolder: 6 Narrative
		lineageTag: 9b2e15aa-000c-53be-bae9-8c33ab261e06

	/// Fixed on operating expenses: in the source ledger all revenue and cost of sales post to one department, so only opex has a meaningful department split.
	measure 'Title Variance by Department' = "Where operating expenses landed vs budget, by department: " & FORMAT ( [Operating Expenses Var vs Budget] / 1e6, "+#,0.0;-#,0.0" ) & "M in total (red = over budget)"
		displayFolder: 6 Narrative
		lineageTag: acddc1b6-12d3-5771-b356-bc2aab3b7d8c

	/// Total assets minus total liabilities and equity at the selected month. Must be 0.
	measure 'DQ Balance Sheet Difference' = CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 108 ), Account[AccountKey] ) ) - CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 120 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);0
		displayFolder: 9 Data Quality
		lineageTag: 971dbbf6-62ff-51d3-afb1-13603eb33288

	measure 'DQ Unmapped Accounts With Activity' = COUNTROWS ( FILTER ( VALUES ( GL[AccountKey] ), NOT ( GL[AccountKey] IN VALUES ( 'Report Line Map'[AccountKey] ) ) && LOOKUPVALUE ( Account[Statement], Account[AccountKey], GL[AccountKey] ) <> "Statistical" ) ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: f53e1658-be3a-575b-87bb-eb7f2ee2914f

	measure 'DQ Accounts Missing From Chart' = COUNTROWS ( FILTER ( VALUES ( GL[AccountKey] ), ISBLANK ( LOOKUPVALUE ( Account[AccountKey], Account[AccountKey], GL[AccountKey] ) ) ) ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 1dcb461d-e9da-5d81-a589-79d266b076c0

	measure 'DQ Rows Missing FX Rate' = COUNTROWS ( FILTER ( GL, ISBLANK ( GL[Rate to CAD] ) ) ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 7ff34a3a-c0d3-5b6b-94db-51af73affb2d

	measure 'DQ Duplicates Removed' = SUM ( 'DQ File Log'[DuplicateRows] ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 2c4e593e-4ec7-599b-9fe4-4fbcb0eceb91

	measure 'DQ Blank Departments Fixed' = SUM ( 'DQ File Log'[MissingDepartmentRows] ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 12e9b875-e289-5865-b299-f005c2605722

	measure 'DQ Files With Schema Drift' = CALCULATE ( COUNTROWS ( 'DQ File Log' ), 'DQ File Log'[SchemaDrift] = TRUE () ) + 0
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 4697f630-9b87-588d-968b-7a7f8e126848

	measure 'DQ Files Loaded' = DISTINCTCOUNT ( GL[SourceFile] )
		formatString: 0
		displayFolder: 9 Data Quality
		lineageTag: 0cd9c979-2b05-573a-b323-70abd1c9fc59

	measure 'DQ Synthetic Budget Share' = DIVIDE ( CALCULATE ( COUNTROWS ( GL ), GL[BudgetSource] = "Synthetic" ), CALCULATE ( COUNTROWS ( GL ), GL[Scenario] = "Budget" ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 9 Data Quality
		lineageTag: 7b2f0615-f61b-5a10-a538-853f60e184ca

	measure 'Metric Var Text' = FORMAT ( [Metric Var vs Budget] / 1e6, "+#,0.0;-#,0.0" ) & "M (" & FORMAT ( [Metric Var % vs Budget], "+0.0%;-0.0%" ) & ") vs budget"
		displayFolder: 6 Narrative
		lineageTag: 7bd59d81-9391-5383-a79a-913e594623f1

	measure 'Metric Gap Text' = FORMAT ( [Metric Outlook Gap] / 1e6, "+#,0.0;-#,0.0" ) & "M vs full-year budget"
		displayFolder: 6 Narrative
		lineageTag: cb3e042a-dbb5-5b09-884a-caaa22ae26ce

	measure 'Metric Growth Text' = FORMAT ( [Metric Growth %], "+0.0%;-0.0%" ) & " vs prior year"
		displayFolder: 6 Narrative
		lineageTag: 5aa86697-c963-5237-942c-5fa81737b3af

	measure 'Title Income Statement' = "Income statement · " & [Period Label] & " · costs negative, positive variance = favourable"
		displayFolder: 6 Narrative
		lineageTag: 639edd4b-9dd3-5d1a-9c2c-9198eb07fe75

	measure 'Title Balance Sheet' = "Balance sheet at " & FORMAT ( [Selected Month], "mmm yyyy" ) & " vs year end " & FORMAT ( DATE ( ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) - 1, 3, 1 ), "mmm yyyy" ) & " · " & [Currency Label]
		displayFolder: 6 Narrative
		lineageTag: 6a68ca65-d921-58ce-9b0b-54c18621f940

	measure 'Title Overview Revenue' = "Net revenue by fiscal year and region · " & [Selected Fiscal Year] & " is year to date (" & FORMAT ( [As Of Month], "mmm yyyy" ) & ")"
		displayFolder: 6 Narrative
		lineageTag: bc88b736-82a5-5253-a145-d5bbcfd22d30

	measure 'Title Revenue Bridge' = "Revenue growth vs prior year: " & FORMAT ( [Revenue Growth %], "+0.0%;-0.0%" ) & ", of which organic " & FORMAT ( [Organic Growth %], "+0.0%;-0.0%" )
		displayFolder: 6 Narrative
		lineageTag: f86a93e8-49ed-5fac-9859-530eb2001665

	measure 'Title EBITDA Bridge' = "EBITDA vs budget: " & FORMAT ( [EBITDA Var vs Budget] / 1e6, "+#,0.0;-#,0.0" ) & "M, by driver"
		displayFolder: 6 Narrative
		lineageTag: 00b8c171-9ba0-57c0-a588-bb7dcef307d7

	measure 'Title DQ' = "Data quality · " & [DQ Files Loaded] & " ledger files loaded · balance-sheet difference " & FORMAT ( [DQ Balance Sheet Difference], "#,0" )
		displayFolder: 6 Narrative
		lineageTag: edf28f89-3518-5e79-a5b5-86b801034a1a

	/// Narrative for the topic on the row of an insight table.
	measure 'Insight Text' = SWITCH ( SELECTEDVALUE ( Insight[Key] ), 1, [Insight Perimeter], 2, [Insight Cost Absorption], 3, [Insight Outlook] )
		displayFolder: 6 Narrative
		lineageTag: 5743f2f0-129c-5925-92e7-cfc7cf45380c

	measure 'Entity Budget Status Color' = IF ( [Entity Budget Status] = "Not budgeted", "#C0392B", "#1F2A37" )
		displayFolder: 8 Formatting
		lineageTag: 76243574-ceef-5703-82e3-a09c1547c840

	measure 'Net Income Outlook Gap Text' = FORMAT ( ( [Net Income Outlook FY] - [Net Income Budget FY] ) / 1e6, "▲ +#,0.0;▼ -#,0.0" ) & "M vs FY budget"
		displayFolder: 6 Narrative
		lineageTag: 4cbf7621-e565-5a2c-9769-798b1981eba4

	measure 'Net Income Outlook Gap Color' = IF ( [Net Income Outlook FY] < [Net Income Budget FY], "#C0392B", "#2E7D32" )
		displayFolder: 8 Formatting
		lineageTag: 6a88aa11-f863-5c53-8583-5144dd179a30

	measure 'Cash Change Text' = VAR c = [Cash] - CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 101 ), Account[AccountKey] ) ) RETURN FORMAT ( c / 1e6, "▲ +#,0.0;▼ -#,0.0" ) & "M vs March year end"
		displayFolder: 6 Narrative
		lineageTag: 4ff6b89b-93cf-5261-ae80-d814407db6f8

	measure 'Cash Change Color' = IF ( [Cash] < CALCULATE ( [Prior Year-End Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 101 ), Account[AccountKey] ) ), "#C0392B", "#2E7D32" )
		displayFolder: 8 Formatting
		lineageTag: 880d1dc2-fcf3-5301-a3fa-8a44bcd12557

	/// Net revenue in millions, for compact tables.
	measure 'Revenue (M)' = DIVIDE ( [Revenue], 1e6 )
		formatString: #,0.0
		displayFolder: 3 KPIs\Revenue
		lineageTag: bf60c564-80d7-5771-a4db-c48d44f54127

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 66e1d7ac-a462-5b8b-8976-c05915894fa6
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				#table(type table [Placeholder = text], {})

	annotation PBI_ResultType = Table

