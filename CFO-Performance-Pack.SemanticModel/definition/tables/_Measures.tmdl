	/// Theme colour "Sidebar Muted": #8FA3BF light / #7F8EA6 dark.
	measure 'Col Sidebar Muted' = IF ( [Is Dark], "#7F8EA6", "#8FA3BF" )
		displayFolder: 10 Theme
