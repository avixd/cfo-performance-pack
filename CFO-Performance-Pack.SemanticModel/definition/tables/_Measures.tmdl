	/// KPI card value: [Salary Cost per Head] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Salary Cost per Head' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			( VAR _x = [Salary Cost per Head] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 11 KPI Cards
		lineageTag: 06d23e25-815e-53fd-b593-06f9c2af8b69

	/// KPI card value: [Current Ratio] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Current Ratio' = FORMAT ( [Current Ratio], "0.00" ) & "x"
		displayFolder: 11 KPI Cards
