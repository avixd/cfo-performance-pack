	/// Theme colour "Sidebar Text": #E8EDF4 light / #E8EDF4 dark.
	measure 'Col Sidebar Text' = IF ( [Is Dark], "#E8EDF4", "#E8EDF4" )
		displayFolder: 10 Theme
