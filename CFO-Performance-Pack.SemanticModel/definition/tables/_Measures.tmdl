	/// Card text for ebitda: variance % to budget and growth % versus last year, with direction arrows.
	measure 'EBITDA vs Budget Text' = VAR v = [EBITDA Var % vs Budget] VAR g = [EBITDA Growth %] RETURN IF ( ISBLANK ( v ), "n.m.", FORMAT ( v, "▲ 0.0%;▼ 0.0%;0.0%" ) ) & " vs Bud  ·  " & IF ( ISBLANK ( g ), "n.m.", FORMAT ( g, "▲ 0.0%;▼ 0.0%;0.0%" ) ) & " vs PY"
		displayFolder: 3 KPIs\EBITDA
		lineageTag: 114e2319-4c5a-568a-9b8b-812d959eb892

	/// Green when ebitda is favourable to budget, red when unfavourable.
	measure 'EBITDA Var Color' = IF ( [EBITDA Var vs Budget] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 0f92d38c-6bce-504d-a1c8-8309109350de

	/// Operating profit (EBITDA less depreciation and amortization) for the period chosen in the Period slicer (MTD, QTD or YTD) ending at the selected month.
	measure EBIT =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 15 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: afbe31ac-f338-5d40-9089-0081841c76c3

	/// Budget for ebit, for the period chosen in the Period slicer (MTD, QTD or YTD) ending at the selected month.
	measure 'EBIT Budget' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Budget (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 15 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: 0e532924-1b03-5135-8f3d-a6662faf3c4b

	/// EBIT for the same period one year earlier.
	measure 'EBIT PY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 15 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: d739c6db-afd8-5834-a6da-03dafa50fdcb

	/// EBIT: actual minus budget. Positive = favourable (costs are stored negative).
	measure 'EBIT Var vs Budget' = [EBIT] - [EBIT Budget]
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: 12f4986e-7153-5393-a8bc-06de26f58eef

	/// EBIT variance as % of absolute budget. Blank when actual and budget have different signs.
	measure 'EBIT Var % vs Budget' = IF ( [EBIT] * [EBIT Budget] > 0, DIVIDE ( [EBIT] - [EBIT Budget], ABS ( [EBIT Budget] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\EBIT
		lineageTag: 9f222a22-f122-5cba-bc01-6578b6650dc9

	/// EBIT growth versus the same period last year. Blank when the signs differ.
	measure 'EBIT Growth %' = IF ( [EBIT] * [EBIT PY] > 0, DIVIDE ( [EBIT] - [EBIT PY], ABS ( [EBIT PY] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\EBIT
		lineageTag: b8f57a2d-046d-5b9f-9c5a-e5e0c369cb24

	/// EBIT full-year outlook: actual to the selected month + budget for the remaining months.
	measure 'EBIT Outlook FY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Outlook FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 15 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: f31c2650-5107-5ec5-bd48-c92b0f0e4052

	/// EBIT budget for the full fiscal year of the selected month.
	measure 'EBIT Budget FY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Budget FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 15 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBIT
		lineageTag: 6b214759-04b7-55d1-a3ef-de30d9819908

	/// Net income after interest, other items and tax for the period chosen in the Period slicer (MTD, QTD or YTD) ending at the selected month.
	measure 'Net Income' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 20 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: d882e907-ef46-50a3-8aef-dac16e0802cb

	/// Budget for net income, for the period chosen in the Period slicer (MTD, QTD or YTD) ending at the selected month.
	measure 'Net Income Budget' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Budget (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 20 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: 24e0f5c0-2303-5ee9-b513-dcb235e52384

	/// Net Income for the same period one year earlier.
	measure 'Net Income PY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 20 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: 11cae03a-50ae-5431-ad18-481547c92bf4

	/// Net Income: actual minus budget. Positive = favourable (costs are stored negative).
	measure 'Net Income Var vs Budget' = [Net Income] - [Net Income Budget]
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: a6d746f4-cef8-517b-a300-80f86d42949b

	/// Net Income variance as % of absolute budget. Blank when actual and budget have different signs.
	measure 'Net Income Var % vs Budget' = IF ( [Net Income] * [Net Income Budget] > 0, DIVIDE ( [Net Income] - [Net Income Budget], ABS ( [Net Income Budget] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Net Income
		lineageTag: 3333b168-c010-5f87-9b3d-3d0d3b4790f1

	/// Net Income growth versus the same period last year. Blank when the signs differ.
	measure 'Net Income Growth %' = IF ( [Net Income] * [Net Income PY] > 0, DIVIDE ( [Net Income] - [Net Income PY], ABS ( [Net Income PY] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Net Income
		lineageTag: 040eb307-7b6d-576a-9567-55228d4e463d

	/// Net Income full-year outlook: actual to the selected month + budget for the remaining months.
	measure 'Net Income Outlook FY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Outlook FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 20 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: 0ce1149e-c88f-500f-b777-159a04a96121

	/// Net Income budget for the full fiscal year of the selected month.
	measure 'Net Income Budget FY' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Budget FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 20 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Net Income
		lineageTag: d818e7cb-e738-53cf-b769-db3419baa168

	/// Card text for net income: variance % to budget and growth % versus last year, with direction arrows.
	measure 'Net Income vs Budget Text' = VAR v = [Net Income Var % vs Budget] VAR g = [Net Income Growth %] RETURN IF ( ISBLANK ( v ), "n.m.", FORMAT ( v, "▲ 0.0%;▼ 0.0%;0.0%" ) ) & " vs Bud  ·  " & IF ( ISBLANK ( g ), "n.m.", FORMAT ( g, "▲ 0.0%;▼ 0.0%;0.0%" ) ) & " vs PY"
		displayFolder: 3 KPIs\Net Income
		lineageTag: e24eccbc-2438-561d-a2ef-6a13b7ac7f4e

	/// Green when net income is favourable to budget, red when unfavourable.
	measure 'Net Income Var Color' = IF ( [Net Income Var vs Budget] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 9120bc2b-d41a-5c67-9273-40ae0fbeb57d

	/// Gross Profit as a share of net revenue.
	measure 'Gross Profit Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 28c08666-964c-5711-bc1d-14a863961595

	/// Budgeted gross profit as a share of budgeted net revenue.
	measure 'Gross Profit Margin % Budget' = DIVIDE ( [Gross Profit Budget], [Revenue Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 966acc4d-26e4-5aa8-9bcd-b545c1213063

	/// Gross Profit margin minus budget margin, in percentage points.
	measure 'Gross Profit Margin pts vs Budget' = [Gross Profit Margin %] - [Gross Profit Margin % Budget]
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: e160db93-20db-5500-a96f-a589f5df38e6

	/// EBITDA as a share of net revenue.
	measure 'EBITDA Margin %' = DIVIDE ( [EBITDA], [Revenue] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 175dd687-35b5-52f0-bd52-2b744dd6fc56

	/// Budgeted ebitda as a share of budgeted net revenue.
	measure 'EBITDA Margin % Budget' = DIVIDE ( [EBITDA Budget], [Revenue Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 44a326e4-9aaa-526b-ad9a-d10122cb340a

	/// EBITDA margin minus budget margin, in percentage points.
	measure 'EBITDA Margin pts vs Budget' = [EBITDA Margin %] - [EBITDA Margin % Budget]
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 231ac0bb-9aa3-5d86-ad97-78cbf463a4c4

	/// Net Income as a share of net revenue.
	measure 'Net Income Margin %' = DIVIDE ( [Net Income], [Revenue] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 03940b68-9ab5-55db-af83-027dd742a560

	/// Budgeted net income as a share of budgeted net revenue.
	measure 'Net Income Margin % Budget' = DIVIDE ( [Net Income Budget], [Revenue Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 86c568b7-9e7d-58ff-8f74-ae96de8274b3

	/// Net Income margin minus budget margin, in percentage points.
	measure 'Net Income Margin pts vs Budget' = [Net Income Margin %] - [Net Income Margin % Budget]
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: f6fd371e-cb22-5bd3-8840-820193059366

	/// Operating expenses as a share of net revenue (shown positive).
	measure 'OpEx % of Revenue' = DIVIDE ( -[Operating Expenses], [Revenue] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Margins
		lineageTag: 5cd763cd-6852-5eb4-8df6-a6f81ff0a3f1

	/// Gross margin versus budget margin, in percentage points.
	measure 'Gross Margin Text' = FORMAT ( [Gross Profit Margin pts vs Budget] * 100, "▲ 0.0;▼ 0.0;0.0" ) & " pts vs budget"
		displayFolder: 3 KPIs\Margins
		lineageTag: f0ace085-c67d-5f24-bf2b-0481339866d5

	/// Green when gross margin is at or above the budget margin.
	measure 'Gross Margin Var Color' = IF ( [Gross Profit Margin pts vs Budget] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 657b2796-adc3-5b75-aebd-08edab8f8aab

	/// Revenue from entities that also traded in the same period last year.
	measure 'Revenue Like-for-Like' = SUMX ( VALUES ( Entity[EntityKey] ), IF ( NOT ISBLANK ( [Revenue PY] ), [Revenue] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 571b3656-8882-5c28-a5a7-dd8c431f2121

	/// Revenue from entities that joined the group within the last twelve months.
	measure 'Revenue New Entities' = [Revenue] - [Revenue Like-for-Like]
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 2731af40-0f56-5775-b3da-9a4852662bdc

	/// Growth of like-for-like revenue versus the same period last year (entities that traded in both periods).
	measure 'Organic Growth %' = DIVIDE ( [Revenue Like-for-Like] - [Revenue PY], ABS ( [Revenue PY] ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: f7e7dd33-e745-50f3-923d-c281ecd89a84

	/// Revenue earned by entities with no budget for the period (acquired after the budget was set).
	measure 'Revenue Unbudgeted' = SUMX ( VALUES ( Entity[EntityKey] ), IF ( ISBLANK ( [Revenue Budget] ), [Revenue] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 8506dea8-aacf-5579-b463-cd8c110b7f39

	/// Revenue variance to budget counting only entities that have a budget for the period.
	measure 'Revenue Var vs Budget (Budgeted Entities)' = SUMX ( VALUES ( Entity[EntityKey] ), IF ( NOT ISBLANK ( [Revenue Budget] ), [Revenue] - [Revenue Budget] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 67928d5d-3ee7-5f09-b18d-e2c42cd44522

	/// Revenue variance % to budget counting only entities that have a budget.
	measure 'Revenue Var % vs Budget (Budgeted Entities)' = DIVIDE ( [Revenue Var vs Budget (Budgeted Entities)], ABS ( [Revenue Budget] ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: cc6d7f53-b4e9-5b4d-9eaf-6df33341550f

	/// Number of entities with actuals in the selected month.
	measure 'Entities Reporting' =
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR m = [Selected Month] RETURN CALCULATE ( DISTINCTCOUNT ( GL[EntityKey] ), GL[Scenario] = "Actual", REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m )
		formatString: 0
		displayFolder: 3 KPIs\Perimeter
		lineageTag: a2100f31-b0dd-51ef-8078-6d56e6bb23ef

	/// Net revenue for the twelve months ending at the selected month (denominator for receivable days).
	measure 'Revenue TTM' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			// Date pattern: the date slicers are removed and replaced by an explicit month window built from [Selected Month], so every visual agrees on the period.
			VAR m = [Selected Month]
			RETURN CALCULATE ( CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] > EDATE ( m, -12 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 405aed6c-59cf-537c-bdae-ce831d0d9f97

	/// Revenue growth vs prior year split into organic (like-for-like entities) and new entities; the waterfall total is the total growth.
	measure 'Revenue Bridge Value' = SWITCH ( SELECTEDVALUE ( 'Revenue Bridge'[Step] ), "Organic growth", [Revenue Like-for-Like] - [Revenue PY], "New entities", [Revenue New Entities] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: e91a2c95-14ea-5c31-ad2e-a811c9497bda

	/// EBITDA variance to budget split by driver; the waterfall total is the EBITDA variance.
	measure 'EBITDA Bridge Value' = SWITCH ( SELECTEDVALUE ( 'EBITDA Bridge'[Step] ), "Revenue", [Revenue Var vs Budget], "Cost of sales", [Cost of Sales Var vs Budget], "Operating expenses", [Operating Expenses Var vs Budget] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\EBITDA
		lineageTag: 91ee8477-bbc8-519f-afc9-050172f05b9f

	/// Net income multiplied by the group's effective ownership of each entity: the share belonging to the parent.
	measure 'Net Income Attributable to Group' =
			// Per-entity pattern: evaluated entity by entity and then summed, because the rule applies to each entity separately.
			SUMX ( VALUES ( Entity[EntityKey] ), CALCULATE ( [Net Income] ) * CALCULATE ( MAX ( Entity[Effective Ownership] ) ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Ownership
		lineageTag: f32749bc-79c2-5fa2-8f3a-9e766a7a1944

	/// Share of profit belonging to minority partners in partly owned entities.
	measure 'Net Income Attributable to NCI' = [Net Income] - [Net Income Attributable to Group]
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Ownership
		lineageTag: 92ec9938-d508-5198-ab20-2a0871b04921

	/// First month the entity appears in the actuals ledger.
	measure 'Entity First Month' = CALCULATE ( MIN ( GL[Month] ), GL[Scenario] = "Actual", REMOVEFILTERS ( 'Date' ) )
		formatString: mmm yyyy
		displayFolder: 3 KPIs\Perimeter
		lineageTag: fdc7cf2e-e4b3-5d15-99bf-3b81201d5ba2

	/// Fiscal year in which the entity first reported actuals.
	measure 'Entity Joined FY' = VAR m = [Entity First Month] RETURN IF ( NOT ISBLANK ( m ), "FY" & ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) )
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 9785311d-35bd-5ed1-89d6-f0dfd6a21bf0

	/// Not budgeted = no budget for the period; Under-budgeted = actual revenue more than twice budget (budget not credible).
	measure 'Entity Budget Status' =
			IF ( NOT ISBLANK ( [Entity First Month] ),
			    IF ( ISBLANK ( [Revenue Budget] ), "Not budgeted", IF ( DIVIDE ( [Revenue], [Revenue Budget] ) > 2, "Under-budgeted", "Budgeted" ) ) )
		displayFolder: 3 KPIs\Perimeter
		lineageTag: db828e70-0bd2-504b-9bb0-2ba83f502e0d

	/// Net revenue for whatever dates are on the axis (e.g. a fiscal-year column).
	measure 'Revenue Actual (in context)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 46294a64-e1fb-51e2-b5f5-53d1b554b829

	/// Month-end cash for each month on the axis.
	measure 'Cash Balance (month)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 101 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 43755276-93c2-56dc-ac29-dc8756a840b5

	/// Trade working capital at each month end: receivables + inventory - payables.
	measure 'Working Capital (month)' =
			// Report-line pattern: the accounts mapped to a report line (Report Line Map) are applied to Account with TREATAS, so a line is data, not hard-coded DAX.
			CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 102 ), Account[AccountKey] ) ) + CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 103 ), Account[AccountKey] ) ) - CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 109 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 4 Balance Sheet KPIs
		lineageTag: 48348524-80a0-5003-94c7-0c08f9e920ce

	/// Row shading for statement tables: subtotal and total rows are tinted, detail rows use the panel colour.
	measure 'Line Row Background' =
			// Theme pattern: colours come from the [Col ...] measures, which switch with the Light/Dark toggle.
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ), SWITCH ( SELECTEDVALUE ( 'Report Line'[LineType] ), "Subtotal", [Col Subtotal], "Total", [Col Total], [Col Panel] ), [Col Panel] )
		displayFolder: 8 Formatting
		lineageTag: f3a26d84-96a6-5619-9778-bcc37eb46ab5

	/// Text colour for growth vs prior year on statement lines: green when favourable.
	measure 'Line Growth Color' = IF ( [Line Growth %] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 8e1d3b0f-c606-5a1b-8b4e-3081d4e0fb67

	/// Balance-sheet movements are shown neutral: a rise in receivables or debt is not good or bad by itself. The cash bridge colours them by cash effect instead.
	measure 'Balance Change Color' = [Col Text]
		displayFolder: 8 Formatting
		lineageTag: 6979cca6-6713-574b-a78e-7a770a05a537

	/// Name of the P&L measure picked in the Metric slicer (Revenue when nothing is selected).
	measure 'Metric Name' = SELECTEDVALUE ( Metric[Metric], "Revenue" )
		displayFolder: 5 Metric Selector
		lineageTag: fe972265-70c9-5538-996e-48e57f7e6401

	/// "Actual" for the P&L measure picked in the Metric slicer on the Budget vs Actual page (Revenue by default).
	measure 'Metric Actual' =
			// Template pattern: the report line (or metric) in context decides which accounts are summed, via TREATAS.
			VAR lk = SELECTEDVALUE ( Metric[LineKey], 3 )
			VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = lk )
			RETURN CALCULATE ( [Actual (Period)], TREATAS ( accts, Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 5 Metric Selector
