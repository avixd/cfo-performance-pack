	/// KPI card value: [Net Income Attributable to Group] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Net Income Attributable to Group' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			( VAR _x = [Net Income Attributable to Group] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) )
		displayFolder: 11 KPI Cards
		lineageTag: 42eb220f-9424-5930-94c9-0e9c5b87fdf1

	/// Net income belonging to non-controlling interests, as an amount and a share of total net income.
	measure 'NCI Text' =
			// Money-text pattern: each ( VAR _x = ... ) block returns an amount as text: $ with one decimal in millions, whole thousands below 1M.
			"Minority partners (NCI) " & ( VAR _x = [Net Income Attributable to NCI] RETURN IF ( NOT ISBLANK ( _x ), SWITCH ( TRUE (), ABS ( _x ) >= 1e6, FORMAT ( _x / 1e6, "$#,0.0\M;($#,0.0\M)" ), ABS ( _x ) >= 1e3, FORMAT ( _x / 1e3, "$#,0\K;($#,0\K)" ), FORMAT ( _x, "$#,0;($#,0)" ) ) ) ) & " · " & FORMAT ( DIVIDE ( [Net Income Attributable to NCI], [Net Income] ), "0%" ) & " of net income"
		displayFolder: 3 KPIs\Ownership
		lineageTag: 864eb134-3bb4-567b-bbd7-0fca2b593b48

