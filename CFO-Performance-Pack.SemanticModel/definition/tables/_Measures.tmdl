	/// "Growth %" for the P&L measure picked in the Metric slicer on the Budget vs Actual page (Revenue by default).
	measure 'Metric Growth %' = IF ( [Metric Actual] * [Metric PY] > 0, DIVIDE ( [Metric Actual] - [Metric PY], ABS ( [Metric PY] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 5 Metric Selector
