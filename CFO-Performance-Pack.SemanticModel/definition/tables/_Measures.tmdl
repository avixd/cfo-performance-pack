	measure 'Footer BS' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Equity roll-forward not reconciled in source data"
		displayFolder: 10 Layout
		lineageTag: 99083275-2f68-5714-99c8-1833cc79d1bc

	measure 'Footer DQ' = "Source: AdventureWorksDW (MIT), re-dated; FY2026-28 budgets synthetic · FX Bank of Canada: P&L monthly avg, BS month end, budget prior-FY avg · Closed " & FORMAT ( [As Of Month], "mmm yyyy" ) & " · Counts recompute on every refresh"
		displayFolder: 10 Layout
		lineageTag: 4578e5f2-d396-5ab7-aed8-b3a772caa386

	/// The region that has reported longest: the like-for-like core against which newer regions are judged.
	measure 'Core Region' =
			VAR t = ADDCOLUMNS ( ALL ( Entity[Region] ), "@f", VAR r = Entity[Region] RETURN CALCULATE ( MIN ( GL[Month] ), REMOVEFILTERS (), GL[Scenario] = "Actual", Entity[Region] = r ) )
			RETURN MAXX ( TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@f] ) ), [@f], ASC, Entity[Region], ASC ), Entity[Region] )
		displayFolder: 3 KPIs\Perimeter
		lineageTag: cf9faa52-479b-561b-ab84-75fb4d3df675

	measure 'Revenue Var Core' = VAR r = [Core Region] RETURN CALCULATE ( [Revenue Var vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 09e9d7e3-c479-516b-bafc-5d269e216c7a

	measure 'Revenue Var % Core' = VAR r = [Core Region] RETURN CALCULATE ( [Revenue Var % vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: b71eda3b-0aec-5a62-86d1-772bf0cbc27a

	measure 'EBITDA Var Core' = VAR r = [Core Region] RETURN CALCULATE ( [EBITDA Var vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: ce04c894-6c52-5372-82ec-209a90145f1f

	measure 'EBITDA Var % Core' = VAR r = [Core Region] RETURN CALCULATE ( [EBITDA Var % vs Budget], KEEPFILTERS ( Entity[Region] = r ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 8bdc5647-b643-5d3f-98f0-22658128eebf

	/// Revenue variance from entities whose budget is credible (actual within 2x budget).
	measure 'Revenue Var Credible' = SUMX ( VALUES ( Entity[EntityKey] ), IF ( NOT ISBLANK ( [Revenue Budget] ) && DIVIDE ( [Revenue], [Revenue Budget] ) <= 2, [Revenue Var vs Budget] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Perimeter
		lineageTag: 8e50f408-2de5-533f-8cf5-2d4bd65c3219

	/// Rank of the absolute budget variance across every entity x P&L detail line in the current selection.
	measure 'Exception Rank' =
			IF ( HASONEVALUE ( Entity[EntityName] ) && HASONEVALUE ( 'Report Line'[LineKey] ) && SELECTEDVALUE ( 'Report Line'[LineType] ) = "Detail",
			    VAR cur = ABS ( [Line Var vs Budget] )
			    VAR grid = CROSSJOIN ( ALLSELECTED ( Entity[EntityName] ),
			        CALCULATETABLE ( VALUES ( 'Report Line'[LineKey] ), REMOVEFILTERS ( 'Report Line' ), 'Report Line'[LineType] = "Detail", 'Report Line'[Statement] = "Income Statement" ) )
			    RETURN IF ( NOT ISBLANK ( cur ), RANKX ( grid, CALCULATE ( ABS ( [Line Var vs Budget] ), REMOVEFILTERS ( 'Report Line'[LineName] ) ), cur, DESC, Dense ) ) )
		formatString: 0
		displayFolder: 7 Exceptions
		lineageTag: 29b7188a-1d83-5d8e-9782-c2b5527874bd

	measure 'Exception Var' = IF ( [Exception Rank] <= 5, [Line Var vs Budget] )
		formatString: #,0,;(#,0,);-
		displayFolder: 7 Exceptions
		lineageTag: abb91187-07ad-5689-8f9e-e7174b526d19

	measure 'Exception Var %' = IF ( [Exception Rank] <= 5, [Line Var % vs Budget] )
		formatString: 0.0%;-0.0%;-
		displayFolder: 7 Exceptions
		lineageTag: e9a77f74-3e3f-57ee-ac6c-f5fa40e092f2

	measure 'Exception Actual' = IF ( [Exception Rank] <= 5, [Line Actual] )
		formatString: #,0,;(#,0,);-
		displayFolder: 7 Exceptions
		lineageTag: ff510c07-ba74-5291-b7c5-c384f33afdc2

	measure 'Exception Rank Shown' = IF ( [Exception Rank] <= 5, [Exception Rank] )
		formatString: 0
		displayFolder: 7 Exceptions
		lineageTag: 771f4717-56ab-5938-bf79-25e68007c397

	measure 'Exception Color' = IF ( [Exception Var] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 7252a2e5-9a21-5226-be88-60ae30b1fdbb

	/// Closing headcount at the selected month (statistical account 96).
	measure Headcount = VAR m = [Selected Month] RETURN CALCULATE ( SUM ( GL[AmountLC] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m, GL[Scenario] = "Actual", Account[AccountKey] = 96 )
		formatString: #,0
		displayFolder: 3 KPIs\People
		lineageTag: dd479a58-702a-5db7-b19c-6ad241a32431

	measure 'Headcount PY' = VAR m = EDATE ( [Selected Month], -12 ) RETURN CALCULATE ( SUM ( GL[AmountLC] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m, GL[Scenario] = "Actual", Account[AccountKey] = 96 )
		formatString: #,0
		displayFolder: 3 KPIs\People
		lineageTag: 8cbba16c-e7cf-5cea-a387-7d7e92bde8ac

	measure 'Salaries Var vs Budget' = CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ) - CALCULATE ( [Budget (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: 3dc573d2-7f21-5dd4-9484-47d39bc5e63c

	/// Salaries & benefits for the period / closing headcount.
	measure 'Salary Cost per Head' = DIVIDE ( -CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ), [Headcount] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: 4c9b1f62-650e-558e-b0e2-99ccd614e3cd

	measure 'Salary Cost per Head PY' = DIVIDE ( -CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 6 ), Account[AccountKey] ) ), [Headcount PY] )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\People
		lineageTag: e7168173-298e-5880-ad67-05f3d0e2de75

	measure 'Insight People Cost' =
			VAR sv = [Salaries Var vs Budget] VAR ov = [Operating Expenses Var vs Budget] VAR hc = [Headcount] VAR hp = [Headcount PY]
			VAR c = [Salary Cost per Head] VAR cp = [Salary Cost per Head PY]
			RETURN "Salaries & benefits ran " & FORMAT ( ( ABS ( sv ) ) / 1e6, "#,0.0" ) & "M" & IF ( sv < 0, " over", " under" ) & " budget" & IF ( ov < 0 && sv < 0, ", " & FORMAT ( DIVIDE ( sv, ov ), "0%" ) & " of the opex overrun", "" ) & ". Headcount "
			    & FORMAT ( hc, "#,0" ) & " (" & FORMAT ( DIVIDE ( hc, hp ) - 1, "+0%;-0%" ) & " vs PY); salary cost per head " & FORMAT ( DIVIDE ( c, cp ) - 1, "+0.0%;-0.0%" ) & " vs PY."
		displayFolder: 6 Narrative
		lineageTag: 5eefb7ae-5e8a-56d1-b9cb-6b069b88dce5

	/// Outlook if the remaining months beat budget by the same ratio as the year to date.
	measure 'Metric Outlook Run-Rate' =
			VAR a = VAR lk = SELECTEDVALUE ( Metric[LineKey], 3 )
			VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = lk )
			RETURN CALCULATE ( [Actual YTD], TREATAS ( accts, Account[AccountKey] ) ) VAR b = VAR lk = SELECTEDVALUE ( Metric[LineKey], 3 )
			VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = lk )
			RETURN CALCULATE ( [Budget YTD], TREATAS ( accts, Account[AccountKey] ) )
			RETURN a + ( [Metric Budget FY] - b ) * DIVIDE ( a, b )
		formatString: #,0;(#,0);-
		displayFolder: 5 Metric Selector
		lineageTag: 5fef84bd-259b-5427-b435-a33deb66edaa

	measure 'VT Story' = "Adventure Works Group at a glance · " & [Selected Fiscal Year]
