	/// "Var % vs Budget" for the P&L measure picked in the Metric slicer on the Budget vs Actual page (Revenue by default).
	measure 'Metric Var % vs Budget' = IF ( [Metric Actual] * [Metric Budget] > 0, DIVIDE ( [Metric Actual] - [Metric Budget], ABS ( [Metric Budget] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 5 Metric Selector
