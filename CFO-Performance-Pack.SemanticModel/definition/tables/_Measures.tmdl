	measure 'Ctx Region' = VAR n = COUNTROWS ( VALUES ( Entity[Region] ) ) RETURN IF ( NOT ISFILTERED ( Entity[Region] ), "All regions", IF ( n <= 2, CONCATENATEX ( VALUES ( Entity[Region] ), Entity[Region], ", " ), n & " selected" ) )
