	/// KPI card value: [Debt to Equity] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Debt to Equity' = FORMAT ( [Debt to Equity], "0.00" ) & "x"
		displayFolder: 11 KPI Cards
		lineageTag: ee29c5ad-33b3-55bb-a404-44567c57f21e

	/// KPI card value: [Cash Conversion Cycle (days)] as text in the report number format ($ M/K for money, % for rates, x for ratios, whole numbers for counts).
	measure 'KV Cash Conversion Cycle (days)' = FORMAT ( [Cash Conversion Cycle (days)], "#,0" )
		displayFolder: 11 KPI Cards
