	measure 'Current Ratio' = DIVIDE ( CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 105 ), Account[AccountKey] ) ), CALCULATE ( [Closing Balance], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 113 ), Account[AccountKey] ) ) )
		formatString: 0.00
