	/// Theme colour "Subtotal": #EEF1F5 light / #1E2B42 dark.
	measure 'Col Subtotal' = IF ( [Is Dark], "#1E2B42", "#EEF1F5" )
		displayFolder: 10 Theme
		lineageTag: 9a7a4ede-0268-5c0c-a2f7-6b5063108715

	/// Theme colour "Total": #DCE3EC light / #26375A dark.
	measure 'Col Total' = IF ( [Is Dark], "#26375A", "#DCE3EC" )
		displayFolder: 10 Theme
		lineageTag: eda87b79-8912-50e9-ba04-1583d27d9e98

	/// Theme colour "Button": #FFFFFF light / #1E2B42 dark.
	measure 'Col Button' = IF ( [Is Dark], "#1E2B42", "#FFFFFF" )
		displayFolder: 10 Theme
		lineageTag: c13897c0-737e-5361-b463-a53edf6db606

	/// Theme colour "Accent Soft": #E6EEF8 light / #1E3350 dark.
	measure 'Col Accent Soft' = IF ( [Is Dark], "#1E3350", "#E6EEF8" )
		displayFolder: 10 Theme
		lineageTag: 213cfa0a-5340-5ab4-8575-6aacbda341e0

	/// Theme colour "Track": #E5E9F0 light / #22314A dark.
	measure 'Col Track' = IF ( [Is Dark], "#22314A", "#E5E9F0" )
		displayFolder: 10 Theme
