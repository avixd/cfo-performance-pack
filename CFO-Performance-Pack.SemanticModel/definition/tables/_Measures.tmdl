/// Home table for all measures, organised in display folders.
table _Measures
	lineageTag: 76288148-93bb-5a23-a24d-abc08674d4e8

	/// Ledger amount in the selected reporting currency (CAD default). Costs are negative.
	measure Amount = IF ( SELECTEDVALUE ( 'Reporting Currency'[Currency], "CAD" ) = "USD", SUM ( GL[Amount USD] ), SUM ( GL[Amount CAD] ) )
		formatString: #,0;(#,0);-
		displayFolder: 0 Base
		lineageTag: 9a50ffa7-ca88-5e2f-8b6c-238da2335e74

	measure 'Currency Label' = SELECTEDVALUE ( 'Reporting Currency'[Currency], "CAD" )
		displayFolder: 0 Base
		lineageTag: 2c53cfe4-60bb-5e3e-910b-6dde63efb7a6

	/// Latest month with actuals loaded (the close). Moves forward automatically when a new actuals file is added.
	measure 'As Of Month' = CALCULATE ( MAX ( GL[Month] ), REMOVEFILTERS (), GL[Scenario] = "Actual" )
		formatString: mmm yyyy
		displayFolder: 0 Base
		lineageTag: cee1f161-cd7e-55e1-b73a-cc6607a75f30

	/// Reporting month: the latest month selected in the date slicers, capped at the close. Defaults to the close.
	measure 'Selected Month' =
			VAR picked = CALCULATE ( MAX ( 'Date'[Month] ), ALLSELECTED ( 'Date' ) )
			VAR asOf = [As Of Month]
			RETURN IF ( ISBLANK ( picked ) || picked > asOf, asOf, picked )
		formatString: mmm yyyy
		displayFolder: 0 Base
		lineageTag: 8f512a59-549d-527e-a031-5bd9c1089a5c

	measure 'Selected Fiscal Year' = VAR m = [Selected Month] RETURN "FY" & ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) )
		displayFolder: 0 Base
		lineageTag: dbd056b0-2852-55be-b0a3-8b721dd86229

	measure 'Fiscal Month Of Selection' = MOD ( MONTH ( [Selected Month] ) + 8, 12 ) + 1
		formatString: 0
		displayFolder: 0 Base
		lineageTag: 3ed48db8-424a-5540-aba3-57c4c7486ead

	measure 'Period Label' = SELECTEDVALUE ( 'Period View'[View], "YTD" ) & " " & FORMAT ( [Selected Month], "mmm yyyy" ) & " · " & [Currency Label]
		displayFolder: 0 Base
		lineageTag: 43499d5c-3d1a-5fc1-9d35-123d26f2e509

	measure Actual = CALCULATE ( [Amount], GL[Scenario] = "Actual" )
		formatString: #,0;(#,0);-
		displayFolder: 0 Base
		lineageTag: 7dcacfbf-8ae5-5219-a4a9-eb38942b5661

	measure Budget = CALCULATE ( [Amount], GL[Scenario] = "Budget" )
		formatString: #,0;(#,0);-
		displayFolder: 0 Base
		lineageTag: 80f270b8-b830-5ecf-8361-ddac5e96cfd2

	measure 'Actual MTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: ee31ae98-7067-53c5-9b4c-d1c8d9cb9224

	measure 'Budget MTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 68ed2d4e-c609-5e85-96d1-f4c8a935f6b0

	measure 'Prior Year MTD' =
			VAR m = EDATE ( [Selected Month], -12 )
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: e4621977-ef57-51a2-aee8-bf2b6bf8cb05

	measure 'Actual QTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( YEAR ( m ), INT ( ( MONTH ( m ) - 1 ) / 3 ) * 3 + 1, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 2e5ce83c-5899-55d6-8452-bb5d8dc39ad9

	measure 'Budget QTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( YEAR ( m ), INT ( ( MONTH ( m ) - 1 ) / 3 ) * 3 + 1, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: afa7e53b-38d2-57d3-b3ae-bb4595cde189

	measure 'Prior Year QTD' =
			VAR m = EDATE ( [Selected Month], -12 )
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( YEAR ( m ), INT ( ( MONTH ( m ) - 1 ) / 3 ) * 3 + 1, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 49bba018-1b9f-5aba-934c-2a606b086b49

	measure 'Actual YTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) - 1, 4, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 2467bada-092b-53a7-aa55-e03a3dcf6e57

	measure 'Budget YTD' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) - 1, 4, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: fcf51821-c2b9-5d89-a40e-c665c4d74061

	measure 'Prior Year YTD' =
			VAR m = EDATE ( [Selected Month], -12 )
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= DATE ( ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) - 1, 4, 1 ) && 'Date'[Month] <= m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 4ce429e6-9118-5836-a7b4-8a0389f97460

	/// Full fiscal-year budget for the year of the selected month.
	measure 'Budget FY' =
			VAR m = [Selected Month] VAR fy = ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) )
			RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year Number] = fy )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: db34269d-2727-5a89-80c6-a5568de3e745

	/// Rolling fiscal-year outlook: actuals to the selected month + budget for the remaining months (Goodly level-3 pattern).
	measure 'Outlook FY' =
			VAR m = [Selected Month] VAR fy = ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) )
			RETURN [Actual YTD] + CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Fiscal Year Number] = fy && 'Date'[Month] > m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 0583feeb-bbb7-5e7c-b3f9-d099759a4942

	measure 'Actual (Period)' = SWITCH ( SELECTEDVALUE ( 'Period View'[View], "YTD" ), "MTD", [Actual MTD], "QTD", [Actual QTD], [Actual YTD] )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 06aaf99d-8d29-5c67-a737-3c28bd5c11fd

	measure 'Budget (Period)' = SWITCH ( SELECTEDVALUE ( 'Period View'[View], "YTD" ), "MTD", [Budget MTD], "QTD", [Budget QTD], [Budget YTD] )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: 74920714-7353-5c2f-aba1-b53b4fba5e96

	measure 'Prior Year (Period)' = SWITCH ( SELECTEDVALUE ( 'Period View'[View], "YTD" ), "MTD", [Prior Year MTD], "QTD", [Prior Year QTD], [Prior Year YTD] )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: e12ffa17-a02e-5fb7-ab7e-0515580c5cc2

	/// Balance-sheet value at the selected month end.
	measure 'Closing Balance' =
			VAR m = [Selected Month]
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = m )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: d216693c-510d-5b54-94ef-c7b90ec21b49

	/// Balance at the previous fiscal year end (31 March).
	measure 'Prior Year-End Balance' =
			VAR m = [Selected Month] VAR ye = DATE ( ( YEAR ( m ) + IF ( MONTH ( m ) >= 4, 1, 0 ) ) - 1, 3, 1 )
			RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = ye )
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)
		lineageTag: e021c823-a265-56f9-864e-1b7d8a0b731b

	/// Month-axis charts: actual for each fiscal month of the selected year, up to the selected month. Independent of which years the date slicer shows.
	measure 'Monthly Actual (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN IF ( d <= sel, CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = d ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: 4dc6c521-8730-5a45-888f-ff242229cc29

	measure 'Monthly Budget (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = d )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: 252a726e-a924-51fa-ba02-b3ff89f3a949

	/// Budget shown as the outlook for months after the selected month.
	measure 'Monthly Outlook (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN IF ( d > sel, CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = d ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: 31bd4af8-3860-59a4-889f-f6f9172dafa9

	measure 'Monthly Prior Year (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] = EDATE ( d, -12 ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: efa05e12-44dc-5178-a1ee-f9cae9ffde74

	measure 'Cumulative Actual (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN IF ( d <= sel, CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= fyStart && 'Date'[Month] <= d ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: 45f20c42-8704-5820-bf77-afc9157a3640

	/// Actual to the selected month plus budget for later months, accumulated: where the year is heading.
	measure 'Cumulative Outlook (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN IF ( d >= sel, CALCULATE ( [Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= fyStart && 'Date'[Month] <= sel ) + CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] > sel && 'Date'[Month] <= d ) )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: 7d2c8a42-7cf0-57f8-863b-449ee11ca37a

	measure 'Cumulative Budget (Selected FY)' =
			IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ),
			    VAR fm = MAX ( 'Date'[Fiscal Month Number] ) VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) )
			    VAR d = DATE ( fy - 1, 3 + fm, 1 ) VAR sel = [Selected Month] VAR fyStart = DATE ( fy - 1, 4, 1 )
			    RETURN CALCULATE ( [Budget], REMOVEFILTERS ( 'Date' ), 'Date'[Month] >= fyStart && 'Date'[Month] <= d )
			)
		formatString: #,0;(#,0);-
		displayFolder: 1 Period (fiscal)\Month axis
		lineageTag: dc78b74b-e345-546e-ace8-6c097ce54619

	/// Report-line value for the Period View; one line at a time.
	measure 'Line Actual' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Actual (Period)], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 68c91e21-55f2-5b38-99de-8f6d555db71a

	measure 'Line Budget' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Budget (Period)], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 0bf568f2-f17c-5e50-b02f-71ff4e75137b

	measure 'Line Prior Year' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Prior Year (Period)], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 3d6bd189-d5e9-5eec-9a45-6c06902b40a2

	/// Positive = favourable (costs are stored negative).
	measure 'Line Var vs Budget' = [Line Actual] - [Line Budget]
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: a1c54cb5-03a4-54a9-9fa4-1ffc24e67ea3

	measure 'Line Var % vs Budget' = IF ( [Line Actual] * [Line Budget] > 0, DIVIDE ( [Line Actual] - [Line Budget], ABS ( [Line Budget] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 2 Statement Lines
		lineageTag: 829a5441-3fb0-5833-a612-a8c9d6e19d43

	measure 'Line Var vs Prior Year' = [Line Actual] - [Line Prior Year]
		formatString: #,0;(#,0);-
		displayFolder: 2 Statement Lines
		lineageTag: 4fccbdd6-7f0f-5f77-bcd5-d5ca572c1e86

	measure 'Line Growth %' = IF ( [Line Actual] * [Line Prior Year] > 0, DIVIDE ( [Line Actual] - [Line Prior Year], ABS ( [Line Prior Year] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 2 Statement Lines
		lineageTag: b48d2990-a997-565d-8982-cf1e9735b98f

	measure 'Line % of Revenue' = DIVIDE ( [Line Actual], CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 2 Statement Lines
		lineageTag: d2024bc5-6541-5751-bc48-04ef87e1acef

	measure 'Line Outlook FY' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Outlook FY], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: dbe7cc83-4b87-5257-8dd4-c78aa5e31f4e

	measure 'Line Budget FY' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Budget FY], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 3763bc90-8398-5641-9fdc-3c3fdf4bf332

	measure 'Line Closing Balance' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Closing Balance], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: af38e13b-7f66-542e-a0f6-1e3bd84b4d09

	measure 'Line Prior Year-End Balance' =
			IF ( HASONEVALUE ( 'Report Line'[LineKey] ),
			    VAR accts = CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), TREATAS ( VALUES ( 'Report Line'[LineKey] ), 'Report Line Map'[LineKey] ) )
			    RETURN CALCULATE ( [Prior Year-End Balance], TREATAS ( accts, Account[AccountKey] ) )
			)
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 7da8bb17-19b6-57a2-82f5-ea702f3facb0

	measure 'Line Balance Change' = [Line Closing Balance] - [Line Prior Year-End Balance]
		formatString: #,0,;(#,0,);-
		displayFolder: 2 Statement Lines
		lineageTag: 660c8fe5-e300-5378-8b59-a5dc474f5cfa

	measure 'Line Var Color' = IF ( [Line Var vs Budget] < 0, [Col Bad], [Col Good] )
		displayFolder: 8 Formatting
		lineageTag: 669bda09-e5bd-57ac-baff-40fb5230b794

	measure Revenue = CALCULATE ( [Actual (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 3ea43793-6346-5570-9733-71810985839b

	measure 'Revenue Budget' = CALCULATE ( [Budget (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: b0c864df-2a50-539c-9917-fd057058b1fe

	measure 'Revenue PY' = CALCULATE ( [Prior Year (Period)], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 81bba724-5de0-5528-a1a8-b612a4bf70b3

	measure 'Revenue Var vs Budget' = [Revenue] - [Revenue Budget]
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 03f2e84c-1c94-5f95-9030-207d83ca5543

	measure 'Revenue Var % vs Budget' = IF ( [Revenue] * [Revenue Budget] > 0, DIVIDE ( [Revenue] - [Revenue Budget], ABS ( [Revenue Budget] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Revenue
		lineageTag: ef136c89-69ae-5b7b-b3ed-89a00172faae

	measure 'Revenue Growth %' = IF ( [Revenue] * [Revenue PY] > 0, DIVIDE ( [Revenue] - [Revenue PY], ABS ( [Revenue PY] ) ) )
		formatString: 0.0%;-0.0%;-
		displayFolder: 3 KPIs\Revenue
		lineageTag: d115b660-0745-54c3-ad3e-076f09b16d02

	measure 'Revenue Outlook FY' = CALCULATE ( [Outlook FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 514570a5-8ad6-5bbd-9a33-8b551e333256

	measure 'Revenue Budget FY' = CALCULATE ( [Budget FY], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
		displayFolder: 3 KPIs\Revenue
		lineageTag: 829d31c5-1661-5713-954c-d7264c558757

	measure 'Revenue Monthly Actual' = CALCULATE ( [Actual], TREATAS ( CALCULATETABLE ( VALUES ( 'Report Line Map'[AccountKey] ), 'Report Line Map'[LineKey] = 3 ), Account[AccountKey] ) )
		formatString: #,0;(#,0);-
