	/// Month-end cash for closed months of the selected fiscal year (sparkline).
	measure 'Cash Spark' = VAR fy = ( YEAR ( [Selected Month] ) + IF ( MONTH ( [Selected Month] ) >= 4, 1, 0 ) ) VAR m = MAX ( 'Date'[Month] ) RETURN IF ( HASONEVALUE ( 'Date'[Fiscal Month Number] ) && m <= [Selected Month] && MAX ( 'Date'[Fiscal Year Number] ) = fy, [Cash Balance (month)] )
		formatString: #,0;(#,0);-
