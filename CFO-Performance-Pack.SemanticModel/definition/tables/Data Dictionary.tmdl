/// Self-documenting catalogue of the model: every table, column, measure and relationship with its description and expression, read from the model itself with the INFO.VIEW functions on each refresh.
table 'Data Dictionary'
	lineageTag: 9f262a8e-9a41-523b-9419-50cd1e2e6ad1

	/// Table, Column, Measure or Relationship.
	column 'Object Type'
		lineageTag: 8c9c4abb-0a8f-5391-8a1d-5ba113b0ff11
		isNameInferred
		sourceColumn: [Object Type]

	/// Table the object belongs to (for a relationship: the many side).
	column Table
		lineageTag: 46220841-d23b-5aaf-9231-d34740a10d72
		isNameInferred
		sourceColumn: [Table]

	/// Object name.
	column Name
		lineageTag: 0430a65a-2f14-5f76-895d-486cd166d782
		isNameInferred
		sourceColumn: [Name]

	/// Business description stored on the object.
	column Description
		lineageTag: feb96edc-66e1-50ab-b633-0ef07b336893
		isNameInferred
		sourceColumn: [Description]

	/// DAX of a measure, calculated column or calculated table; the join for a relationship.
	column Expression
		lineageTag: 830d08a2-cdea-556f-8fcb-1d34bb5f603d
		isNameInferred
		sourceColumn: [Expression]

	/// Display folder.
	column Folder
		lineageTag: c0db1786-5e41-5623-a74f-2cdbf9ab4524
		isNameInferred
		sourceColumn: [Folder]

	partition 'Data Dictionary' = calculated
		mode: import
		source =
				-- Data dictionary (pattern from the INFO.VIEW documentation technique): one VAR per object type, UNION at the end.
				-- INFO.VIEW functions read the model's own metadata on every refresh, so the dictionary cannot drift from the model.
				-- Hidden objects are left out (they are plumbing, not something a reader should use), and the dictionary leaves itself out.
				VAR __Tables =
				    SELECTCOLUMNS (
				        FILTER ( INFO.VIEW.TABLES (), [IsHidden] = FALSE () && NOT [IsPrivate] && [Name] <> "Data Dictionary" ),
				        "Object Type", "Table", "Table", [Name], "Name", [Name], "Description", [Description],
				        "Expression", [Expression], "Folder", BLANK ()
				    )
				VAR __Columns =
				    SELECTCOLUMNS (
				        FILTER ( INFO.VIEW.COLUMNS (), [IsHidden] = FALSE () && [Table] <> "Data Dictionary" ),
				        "Object Type", "Column", "Table", [Table], "Name", [Name], "Description", [Description],
				        "Expression", [Expression], "Folder", [DisplayFolder]
				    )
				VAR __Measures =
				    SELECTCOLUMNS (
				        FILTER ( INFO.VIEW.MEASURES (), [IsHidden] = FALSE () ),
				        "Object Type", "Measure", "Table", [Table], "Name", [Name], "Description", [Description],
				        "Expression", [Expression], "Folder", [DisplayFolder]
				    )
				VAR __Relationships =
				    SELECTCOLUMNS (
				        INFO.VIEW.RELATIONSHIPS (),
				        "Object Type", "Relationship", "Table", [FromTable], "Name", [Relationship],
				        "Description", "From " & [FromTable] & " to " & [ToTable] & IF ( [IsActive], "", " (inactive)" ),
				        "Expression", [Relationship], "Folder", BLANK ()
				    )
				RETURN
				    UNION ( __Tables, __Columns, __Measures, __Relationships )

